Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 38; 41
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Path
      Name: Coverage Path
      Enabled: true
      Topic: /coverage_path
      Line Style: Lines
      Line Width: 0.05
      Color: 25; 140; 255
      Buffer Length: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Coverage Markers
      Enabled: true
      Topic: /coverage_markers
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 25
Window Geometry:
  Width: 1200
  Height: 800
