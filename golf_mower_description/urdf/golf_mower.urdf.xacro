<?xml version="1.0"?>
<!-- xmlns:xacro 声明 xacro 的命名空间，这允许使用 xacro 特有的语法 -->
<robot name="golf_mower" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Coordinate convention:
      x forward, y left, z up.
      base_link is the robot body reference frame used by Nav2.

    Replace the default origins with measured values from the real robot.
    All translations are meters; roll/pitch/yaw are radians.
  -->
  <xacro:arg name="base_length" default="1.30"/> 
  <xacro:arg name="base_width" default="0.90"/>
  <xacro:arg name="base_height" default="0.30"/>
  <xacro:arg name="base_z" default="0.25"/>

  <xacro:arg name="lidar_x" default="0.35"/>
  <xacro:arg name="lidar_y" default="0.0"/>
  <xacro:arg name="lidar_z" default="0.65"/>
  <xacro:arg name="lidar_roll" default="0.0"/>
  <xacro:arg name="lidar_pitch" default="0.0"/>
  <xacro:arg name="lidar_yaw" default="0.0"/>

  <!-- Default IMU origin = default LiDAR origin + [-0.007698, -0.014655, 0.00667]. -->
  <xacro:arg name="imu_x" default="0.342302"/>
  <xacro:arg name="imu_y" default="-0.014655"/>
  <xacro:arg name="imu_z" default="0.65667"/>
  <xacro:arg name="imu_roll" default="0.0"/>
  <xacro:arg name="imu_pitch" default="0.0"/>
  <xacro:arg name="imu_yaw" default="0.0"/>

  <xacro:arg name="rtk_x" default="0.0"/>
  <xacro:arg name="rtk_y" default="0.0"/>
  <xacro:arg name="rtk_z" default="1.00"/>
  <xacro:arg name="rtk_roll" default="0.0"/>
  <xacro:arg name="rtk_pitch" default="0.0"/>
  <xacro:arg name="rtk_yaw" default="0.0"/>

  <xacro:arg name="mower_x" default="-0.15"/>
  <xacro:arg name="mower_y" default="0.0"/>
  <xacro:arg name="mower_z" default="-0.10"/>
  <xacro:arg name="mower_roll" default="0.0"/>
  <xacro:arg name="mower_pitch" default="0.0"/>
  <xacro:arg name="mower_yaw" default="0.0"/>
  <xacro:arg name="mower_width" default="0.80"/>
  <xacro:arg name="mower_length" default="0.35"/>

  <xacro:arg name="wheel_radius" default="0.16"/>
  <xacro:arg name="wheel_width" default="0.08"/>
  <xacro:arg name="wheel_x" default="-0.20"/>
  <xacro:arg name="wheel_y" default="0.48"/>
  <xacro:arg name="wheel_z" default="0.0"/>

  <xacro:property name="base_length" value="$(arg base_length)"/>
  <xacro:property name="base_width" value="$(arg base_width)"/>
  <xacro:property name="base_height" value="$(arg base_height)"/>
  <xacro:property name="base_z" value="$(arg base_z)"/>
  <xacro:property name="mower_width" value="$(arg mower_width)"/>
  <xacro:property name="mower_length" value="$(arg mower_length)"/>
  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>

<!-- 定义颜色和透明度主要是为了可视化显示 -->
  <material name="body_gray">
    <color rgba="0.25 0.28 0.30 1.0"/>
  </material>
  <material name="sensor_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="rtk_white">
    <color rgba="0.92 0.92 0.86 1.0"/>
  </material>
  <material name="mower_green">
    <color rgba="0.10 0.45 0.18 0.75"/>
  </material>

  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <link name="unilidar_lidar">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.075"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>

  <joint name="base_link_to_unilidar_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="unilidar_lidar"/>
    <origin
      xyz="$(arg lidar_x) $(arg lidar_y) $(arg lidar_z)"
      rpy="$(arg lidar_roll) $(arg lidar_pitch) $(arg lidar_yaw)"/>
  </joint>

  <link name="unilidar_imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.04 0.02"/>
      </geometry>
      <material name="sensor_black"/>
    </visual>
  </link>

  <joint name="base_link_to_unilidar_imu" type="fixed">
    <parent link="base_link"/>
    <child link="unilidar_imu"/>
    <origin
      xyz="$(arg imu_x) $(arg imu_y) $(arg imu_z)"
      rpy="$(arg imu_roll) $(arg imu_pitch) $(arg imu_yaw)"/>
  </joint>

  <link name="rtk_antenna">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="rtk_white"/>
    </visual>
  </link>

  <joint name="base_link_to_rtk_antenna" type="fixed">
    <parent link="base_link"/>
    <child link="rtk_antenna"/>
    <origin
      xyz="$(arg rtk_x) $(arg rtk_y) $(arg rtk_z)"
      rpy="$(arg rtk_roll) $(arg rtk_pitch) $(arg rtk_yaw)"/>
  </joint>

  <link name="mower_tool">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${mower_length} ${mower_width} 0.04"/>
      </geometry>
      <material name="mower_green"/>
    </visual>
  </link>

  <joint name="base_link_to_mower_tool" type="fixed">
    <parent link="base_link"/>
    <child link="mower_tool"/>
    <origin
      xyz="$(arg mower_x) $(arg mower_y) $(arg mower_z)"
      rpy="$(arg mower_roll) $(arg mower_pitch) $(arg mower_yaw)"/>
  </joint>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="sensor_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
    </link>
    <joint name="base_link_to_${name}" type="fixed">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="$(arg wheel_x) ${y} $(arg wheel_z)" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="left_wheel" y="$(arg wheel_y)"/>
  <xacro:wheel name="right_wheel" y="-$(arg wheel_y)"/>
</robot>
